{
  "name": "effect-cicd",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "cli": "bun run index.ts",
    "prepare": "effect-language-service patch",
    "typecheck": "tsc --noEmit",
    "test": "bun run --bun vitest run",
    "test:watch": "bun run --bun vitest",
    "server": "bun run server.ts",
    "server:dev": "bun --hot server.ts",
    "dashboard": "bun run dashboard.ts",
    "dashboard:dev": "bun --hot dashboard.ts",
    "infra:up": "docker compose -f compose.demo.yml up -d",
    "infra:down": "docker compose -f compose.demo.yml down",
    "infra:logs": "docker compose -f compose.demo.yml logs -f",
    "test:storage": "RUN_STORAGE_TESTS=1 bun run test"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@effect/vitest": "^4.0.0-beta.74",
    "@effect/platform-node-shared": "^4.0.0-beta.74",
    "@types/bun": "latest",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0-beta.74",
    "@effect/sql-pg": "^4.0.0-beta.74",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^4.0.0-beta.74",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.9.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  }
}
