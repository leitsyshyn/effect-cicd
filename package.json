{
  "name": "effect-cicd",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "effect-language-service patch",
    "typecheck": "tsc --noEmit",
    "test": "bun run --bun vitest run",
    "test:watch": "bun run --bun vitest",

    "infra:up": "docker compose -f compose.demo.yml up -d",
    "infra:down": "docker compose -f compose.demo.yml down",
    "infra:logs": "docker compose -f compose.demo.yml logs -f",
    "test:storage": "RUN_STORAGE_TESTS=1 bun run test"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@effect/vitest": "^4.0.0-beta.74",
    "@effect/platform-node-shared": "^4.0.0-beta.74",
    "@types/bun": "latest",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0-beta.74",
    "@effect/sql-pg": "^4.0.0-beta.74",
    "effect": "^4.0.0-beta.74"
  }
}
