# Local Docker infra (compose.demo.yml)
# Copy to .env for local runs: `cp .env.demo .env`

# Postgres-backed StateStore/EventLog
POSTGRES_URL=postgres://ci:secret@localhost:5432/effect_cicd

# MinIO-backed ArtifactStore (Bun.S3Client)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=effect-cicd-artifacts
S3_ACCESS_KEY=minio-access
S3_SECRET_KEY=minio-secret

# MinIO requires path-style for localhost endpoints
S3_PATH_STYLE=true

# Optional key prefix inside the bucket
# S3_PREFIX=dev/artifacts

# Runtime toggles
RUN_RECOVERY_ON_STARTUP=true

# Required for durable secret-store initialization.
# Generate with: openssl rand -base64 32
SECRETS_MASTER_KEY=replace-with-base64-32-byte-key

# GitHub App integration
# GITHUB_APP_ID=1234567
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=replace-me
# PUBLIC_BASE_URL=https://your-dashboard-or-service-base-url
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_WORKSPACE_ROOT=/absolute/path/to/.effect-cicd/github

# Guarded integration tests (see tests/storage.integration.test.ts)
# Must be exactly "1" to enable.
RUN_STORAGE_TESTS=0
